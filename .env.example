# ============================================
# DISCREETKIT ENVIRONMENT VARIABLES (TEMPLATE)
# ============================================

# -------------------- SUPABASE --------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# -------------------- PAYSTACK --------------------
PAYSTACK_SECRET_KEY=your_paystack_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# -------------------- ARKESEL SMS --------------------
ARKESEL_API_KEY=your_arkesel_api_key
ARKESEL_SENDER_ID=DiscreetKit

# -------------------- RESEND EMAIL --------------------
RESEND_API_KEY=your_resend_api_key

# -------------------- OPENAI --------------------
OPENAI_API_KEY=your_openai_api_key

# -------------------- ADMIN & SESSION --------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password
SESSION_SECRET=your_session_secret

# -------------------- CLOUDINARY --------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_name

# -------------------- SITE URLS --------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
NEXT_PUBLIC_PHARMACY_URL=http://localhost:3000
# Optional: set shared root domain to keep auth cookies across admin/pharmacy subdomains
NEXT_PUBLIC_COOKIE_DOMAIN=

# -------------------- UPSTASH REDIS --------------------
UPSTASH_REDIS_REST_URL=your_upstash_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# -------------------- SECURITY & OBSERVABILITY --------------------
# Set to 1 in Production to enable report-only CSP header
CSP_REPORT_ONLY=0
# Optional: Sentry DSN for forwarding CSP violations to Sentry
SENTRY_DSN=
